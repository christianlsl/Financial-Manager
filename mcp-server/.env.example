# ===== Financial Manager MCP Server 环境配置 =====
# 复制为 .env 并按需修改（本地调试用；Docker 部署时在项目根 .env 配置）

# 后端 REST API 地址（本地开发时是后端 uvicorn 地址；Docker 内是 http://backend:9910）
FM_API_BASE_URL=http://127.0.0.1:9910

# MCP 服务监听地址与端口
FM_MCP_HOST=0.0.0.0
FM_MCP_PORT=9911

# 可选：网关级 Bearer Token（所有用户的 WorkBuddy 连接时都要带上同一个 Token）。
# 用户身份由对话中的 login 工具（网站账号密码）认证，与此无关。
# 留空 = 不启用网关鉴权，仅依赖用户级 login。
FM_MCP_TOKEN=

# 账单输出目录
FM_INVOICE_DIR=invoices
